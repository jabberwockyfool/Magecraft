<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MagecraftPacker</AssemblyName>
    <RootNamespace>Magecraft</RootNamespace>
    <ApplicationIcon>..\..\ICON.ico</ApplicationIcon>
    <AssemblyTitle>Magecraft Packer</AssemblyTitle>
    <Product>Magecraft</Product>
    <Company>Les Enfants du ChaoS</Company>
    <Version>1.0.0</Version>
    <DebugType>embedded</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="PackerForm.cs" />
    <!-- Partages avec Magecraft : appel a sc3tools et format MPK. -->
    <Compile Include="..\Magecraft\Sc3Tools.cs" />
    <Compile Include="..\Magecraft\Mpk.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

</Project>
