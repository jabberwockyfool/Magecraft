<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Magecraft</AssemblyName>
    <RootNamespace>Magecraft</RootNamespace>
    <ApplicationIcon>..\..\ICON.ico</ApplicationIcon>
    <AssemblyTitle>Magecraft</AssemblyTitle>
    <Product>Magecraft</Product>
    <Company>Les Enfants du ChaoS</Company>
    <Version>1.0.0</Version>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Permet de compiler net48 avec le SDK dotnet, sans Visual Studio. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
